# Built application files
*.apk
*.aar
*.ap_
*.aab
*.dex
*.class

# Generated files
bin/
gen/
out/
build/
release/

# Gradle
.gradle/
local.properties

# Android Studio / IntelliJ
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/

# Keystores
*.jks
*.keystore

# Secrets - service account keys grant admin access to the Firebase project and
# must never be committed, especially in a public repo. The Android app does not
# use them; it only needs app/google-services.json.
*-adminsdk-*.json
service-account*.json
*serviceAccount*.json
secrets.properties

# macOS
.DS_Store

# Note: app/google-services.json is deliberately NOT ignored. It is a client
# config file, not a secret, and committing it means the project builds and runs
# straight from a clone - which is what a marker needs. Firestore access is
# restricted by security rules, not by hiding this file.
