<?xml version="1.0" encoding="utf-8"?>
<!--
    Suggested Recipes screen. The strict list sits at the top; the optional
    "almost there" section sits below a divider and its own heading, so the two
    can never be mistaken for one list.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_suggestions"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="@string/nav_suggestions"
        app:titleTextColor="?attr/colorOnPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scroll_suggestions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar_suggestions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_lg">

            <!-- Strict matches: recipes the pantry fully covers. -->
            <TextView
                android:id="@+id/text_suggested_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                android:paddingTop="@dimen/space_lg"
                android:paddingBottom="@dimen/space_xs"
                android:text="@string/suggestions_can_cook"
                android:textAppearance="@style/TextAppearance.Skaflik.SectionHeading" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_suggested"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- Empty state, shown when nothing matches. -->
            <TextView
                android:id="@+id/text_empty_suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_xxl"
                android:layout_marginTop="@dimen/space_xxl"
                android:gravity="center"
                android:text="@string/empty_suggestions"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:visibility="gone" />

            <!-- Divider and heading for the near misses. Hidden when empty. -->
            <View
                android:id="@+id/divider_almost_there"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
                android:layout_marginTop="@dimen/space_xl"
                android:background="?attr/colorOutline"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_almost_there_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                android:paddingTop="@dimen/space_lg"
                android:paddingBottom="@dimen/space_xs"
                android:text="@string/suggestions_almost_there"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorSecondary"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_almost_there"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
