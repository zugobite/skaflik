<?xml version="1.0" encoding="utf-8"?>
<!--
    A placeholder pantry row. Deliberately mirrors item_pantry: name on the
    left, amount on the right, expiry underneath, so the real rows land where
    the skeleton promised they would.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Skaflik.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="false"
    android:focusable="false"
    android:importantForAccessibility="no">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/list_item_padding">

        <View
            android:layout_width="@dimen/skeleton_width_lg"
            android:layout_height="@dimen/skeleton_line_title"
            android:background="@drawable/bg_skeleton_block"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/skeleton_row_amount"
            android:layout_width="@dimen/skeleton_width_sm"
            android:layout_height="@dimen/skeleton_line_title"
            android:background="@drawable/bg_skeleton_block"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="@dimen/skeleton_width_md"
            android:layout_height="@dimen/skeleton_line_body"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_skeleton_block"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/skeleton_row_amount" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
