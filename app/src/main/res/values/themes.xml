<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme, built on Material 3. -->
    <style name="Theme.Skaflik" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/skaflik_green</item>
        <item name="colorPrimaryDark">@color/skaflik_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/skaflik_terracotta</item>
        <item name="colorOnSecondary">@color/white</item>
        <!--
            targetSdk 36 enforces edge-to-edge, so the system ignores
            statusBarColor and the bar sits over the window background. Asking
            for dark status-bar icons keeps the clock readable against it.
        -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <!-- Required by PreferenceFragmentCompat; without it the Settings
             screen throws when it inflates. -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

</resources>
