<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings screen contents. The keys here must match the constants in
    UserPreferences, which is what the rest of the app reads.
-->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/settings_category_pantry">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_expiry_alerts"
            app:summaryOff="@string/settings_expiry_alerts_off"
            app:summaryOn="@string/settings_expiry_alerts_on"
            app:title="@string/settings_expiry_alerts" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_category_units">

        <ListPreference
            app:defaultValue="metric"
            app:entries="@array/unit_system_labels"
            app:entryValues="@array/unit_system_values"
            app:key="pref_unit_system"
            app:title="@string/settings_unit_system"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_category_appearance">

        <ListPreference
            app:defaultValue="system"
            app:entries="@array/theme_labels"
            app:entryValues="@array/theme_values"
            app:key="pref_theme"
            app:title="@string/settings_theme"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <!--
        About. The version and package name are filled in at runtime from the
        installed package, so they can never drift from what is actually on the
        device the way a hard-coded string would.
    -->
    <PreferenceCategory app:title="@string/settings_category_about">

        <Preference
            app:key="pref_about"
            app:selectable="false"
            app:summary="@string/settings_about_summary"
            app:title="@string/app_name" />

        <Preference
            app:key="pref_about_version"
            app:selectable="false"
            app:title="@string/settings_about_version" />

        <Preference
            app:key="pref_about_developer"
            app:selectable="false"
            app:summary="@string/settings_about_developer_name"
            app:title="@string/settings_about_developer" />

        <Preference
            app:key="pref_about_package"
            app:selectable="false"
            app:title="@string/settings_about_package" />

        <Preference
            app:key="pref_about_legal"
            app:selectable="false"
            app:summary="@string/settings_about_legal_summary"
            app:title="@string/settings_about_legal" />

    </PreferenceCategory>

</PreferenceScreen>
