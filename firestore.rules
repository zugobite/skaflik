rules_version = '2';

// Security rules for the Skaflik Firestore database.
//
// Deploy by pasting into: Firebase console -> Firestore Database -> Rules.
// These replace the default test-mode rules, which allow anyone to read and
// write everything and expire 30 days after the database is created.
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's pantry is private to that user. The UID in the path must match
    // the UID on the request, so one device can never read or write another's
    // pantry even though every account here is anonymous.
    match /users/{userId}/pantryItems/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Recipes are shared reference data: readable by any signed-in user, and
    // not writable from the app at all. Seeding is the one exception below.
    match /recipes/{recipeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && !exists(/databases/$(database)/documents/meta/seed);
    }

    // The seed marker. Readable so the app can check whether seeding has run,
    // and writable only while it has not - once it exists, it can never be
    // changed or deleted from a client, which permanently closes the recipe
    // write path above.
    match /meta/seed {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Anything not matched above is denied.
  }
}
